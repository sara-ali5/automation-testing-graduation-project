<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite
        name="OrangeHRM Test Suite"
        parallel="tests"
        thread-count="3">

    <test name="Login Tests">

        <classes>
            <class name="Tests.LoginTest"/>
        </classes>

    </test>

    <test name="PIM Tests">

        <classes>
            <class name="Tests.PIMTest"/>
        </classes>

    </test>

    <test name="Admin Tests">

        <classes>
            <class name="Tests.AdminTest"/>
        </classes>

    </test>

    <test name="UI Tests">

        <classes>
            <class name="Tests.FooterTest"/>
            <class name="Tests.SidebarTest"/>
        </classes>

    </test>

    <listeners>

        <listener class-name="Listeners.CustomTestListener"/>

        <listener class-name="Listeners.CustomeExecutionListener"/>

    </listeners>

</suite>